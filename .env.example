# mine-flow-app — environment configuration
#
# Copy this file to `.env` and fill in real values for local development.
# The `.env` file is gitignored and must NEVER be committed.
#
# In CI (Staging and Production), these values are stored in GitHub Repository
# Secrets and injected as `--dart-define` flags by GitHub Actions during the
# build — see .github/workflows/ci.yml and Doc 09 — Environments §2.
#
# Usage (local dev):
#   flutter run \
#     --dart-define=SUPABASE_URL=$SUPABASE_URL \
#     --dart-define=SUPABASE_ANON_KEY=$SUPABASE_ANON_KEY \
#     --dart-define=GOOGLE_DRIVE_CLIENT_ID=$GOOGLE_DRIVE_CLIENT_ID \
#     --dart-define=APP_ENV=local

# ---------------------------------------------------------------------------
# Supabase (Doc 03 — Architecture Overview: App ↔ Supabase boundary)
# ---------------------------------------------------------------------------

# The URL of your Supabase project.
# Find it in: Supabase Dashboard → Project Settings → API → Project URL
SUPABASE_URL=

# The anon (public) key for your Supabase project.
# Safe to embed in the client — RLS enforces actual row-level security.
# Find it in: Supabase Dashboard → Project Settings → API → anon public
SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# Google APIs (Doc 03 — Architecture Overview: App ↔ Google Drive boundary)
# ---------------------------------------------------------------------------

# OAuth 2.0 Client ID for Google Drive API access.
# Create at: console.cloud.google.com → APIs & Services → Credentials
GOOGLE_DRIVE_CLIENT_ID=

# ---------------------------------------------------------------------------
# Build environment
# ---------------------------------------------------------------------------

# The deployment environment. One of: local | staging | production
# Used to conditionally enable debug tooling and logging verbosity.
APP_ENV=local
